@article{maier_observer_2026,
	title = {Observer {Effects} on (s){Objective} {Reality} {Formation}: a failed replication},
	volume = {6},
	copyright = {https://creativecommons.org/licenses/by/4.0},
	issn = {2004-1969, 2004-1977},
	shorttitle = {\textbf{{Observer} {Effects} on (s){Objective} {Reality} {Formation}}},
	url = {https://journals.lub.lu.se/jaex/article/view/26236},
	doi = {10.31156/jaex.26236},
	abstract = {This preregistered study attempted to replicate a finding obtained from a re-analysis of a data set from an original micro-psychokinesis (micro-PK) study that presented a data-erasure manipulation performed in the context of quantum-based outcome observations (positive vs. negative picture presentations). The experimental manipulation of the availability or unavailability of objective data (objective number of positive pictures) revealed a predicted effect on subjective measures (recalled number of positive pictures) in the original data (moderate to strong Bayesian evidence). Observer-dependent biases measured based on subjective memory recalls of quantum events indicated a higher deviation from the Born rule, that is a higher recalled number of positive pictures, when objective data were absent than when objective data were present. The present study tested the replicability of this erasure result. We assessed the impact of intentional observation on quantum-based stochastic outcomes obtained from the qRNG (number of positive pictures) through subjective memory recall data about these events under experimental variation of the erasure of objective recordings. Against our prediction, subjective recall data did not vary with the experimental variation of the erasure of objective data: Participants did not recall more positive pictures in the erasure compared to the no-erasure condition. Thus, the replication attempt failed. The results indicate that intentional observation effects on quantum outcomes cannot be scientifically documented either with subjective or objective data of these outcomes. This calls into question the existence of intentional observer effects on macroscopic quantum outcomes. An alternative interpretation that such effects might decline after initial appearance is discussed.},
	language = {en},
	number = {2},
	urldate = {2026-10-24},
	journal = {Journal of Anomalous Experience and Cognition},
	author = {Maier, Markus and Dechamps, Moritz and Rabeyron, Thomas},
	month = oct,
	year = {2026},
	pages = {187--208},
}

